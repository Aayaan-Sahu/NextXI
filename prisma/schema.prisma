// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

enum Visibility {
  PRIVATE @map("private")
  PUBLIC  @map("public")

  @@map("visibility")
  @@schema("public")
}

enum ConnectionStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  REVOKED  @map("revoked")

  @@map("connection_status")
  @@schema("public")
}

enum ReportStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  READY      @map("ready")
  FAILED     @map("failed")

  @@map("report_status")
  @@schema("public")
}

enum PlayerRole {
  BATTER       @map("batter")
  PACE         @map("pace")
  OFF_SPIN     @map("off_spin")
  LEG_SPIN     @map("leg_spin")
  WICKETKEEPER @map("wicketkeeper")
  ALL_ROUNDER  @map("all_rounder")

  @@map("player_role")
  @@schema("public")
}

enum CoachStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")

  @@map("coach_status")
  @@schema("public")
}

enum PlayerStatus {
  ACTIVE           @map("active")
  PENDING_GUARDIAN @map("pending_guardian")

  @@map("player_status")
  @@schema("public")
}

enum PlayerVideoStatus {
  PENDING_UPLOAD @map("pending_upload")
  READY          @map("ready")

  @@map("player_video_status")
  @@schema("public")
}

enum VideoCategory {
  PACE     @map("pace")
  OFF_SPIN @map("off_spin")
  LEG_SPIN @map("leg_spin")
  BATTING  @map("batting")

  @@map("video_category")
  @@schema("public")
}

enum Handedness {
  RIGHT @map("right")
  LEFT  @map("left")

  @@map("handedness")
  @@schema("public")
}

enum CoachSpecialty {
  BATTING       @map("batting")
  PACE_BOWLING  @map("pace_bowling")
  SPIN_BOWLING  @map("spin_bowling")
  WICKETKEEPING @map("wicketkeeping")
  FIELDING      @map("fielding")
  FITNESS       @map("fitness")

  @@map("coach_specialty")
  @@schema("public")
}

model Player {
  id                String            @id @db.Uuid
  authUser          AuthUser          @relation("PlayerAuthUser", fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  videos            PlayerVideo[]
  sessions          PracticeSession[]
  statEntries       StatEntry[]
  goals             Goal[]
  reminders         Reminder[]
  name              String
  dateOfBirth       DateTime          @map("date_of_birth") @db.Date
  club              String
  country           String
  roles             PlayerRole[]      @default([])
  heightCm          Int               @map("height_cm")
  weightKg          Int?              @map("weight_kg")
  visibility        Visibility        @default(PRIVATE)
  status            PlayerStatus      @default(ACTIVE)
  bio               String?
  avatarPath        String?           @map("avatar_path")
  battingHandedness Handedness?       @map("batting_handedness")
  bowlingHandedness Handedness?       @map("bowling_handedness")
  guardianCode      String?           @unique @map("guardian_code")
  guardianId        String?           @map("guardian_id") @db.Uuid
  guardian          Guardian?         @relation("PlayerGuardian", fields: [guardianId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("players")
  @@schema("public")
}

model Guardian {
  id        String   @id @db.Uuid
  authUser  AuthUser @relation("GuardianAuthUser", fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name      String
  children  Player[] @relation("PlayerGuardian")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("guardians")
  @@schema("public")
}

model Coach {
  id              String           @id @db.Uuid
  authUser        AuthUser         @relation("CoachAuthUser", fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name            String
  accomplishments String[]         @default([])
  status          CoachStatus      @default(PENDING)
  bio             String?
  avatarPath      String?          @map("avatar_path")
  club            String?
  specialties     CoachSpecialty[] @default([])
  certifications  String[]         @default([])
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("coaches")
  @@schema("public")
}

model Profile {
  id        String   @id @db.Uuid
  authUser  AuthUser @relation("ProfileAuthUser", fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  username  String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
  @@schema("public")
}

model Connection {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAId       String           @map("user_a_id") @db.Uuid
  userBId       String           @map("user_b_id") @db.Uuid
  requestedById String           @map("requested_by_id") @db.Uuid
  status        ConnectionStatus @default(PENDING)
  userA         AuthUser         @relation("ConnectionUserA", fields: [userAId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userB         AuthUser         @relation("ConnectionUserB", fields: [userBId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  requestedBy   AuthUser         @relation("ConnectionRequester", fields: [requestedById], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages      Message[]
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userAId, userBId])
  @@index([userAId, status], map: "connections_user_a_status_idx")
  @@index([userBId, status], map: "connections_user_b_status_idx")
  @@map("connections")
  @@schema("public")
}

model Message {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId String     @map("connection_id") @db.Uuid
  senderId     String     @map("sender_id") @db.Uuid
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender       AuthUser   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  body         String
  readAt       DateTime?  @map("read_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([connectionId, createdAt], map: "messages_connection_created_at_idx")
  @@map("messages")
  @@schema("public")
}

model PlayerVideo {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId         String            @map("player_id") @db.Uuid
  player           Player            @relation(fields: [playerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  storageBucket    String            @map("storage_bucket")
  storagePath      String            @unique @map("storage_path")
  thumbnailPath    String?           @map("thumbnail_path")
  originalFilename String            @map("original_filename")
  contentType      String            @map("content_type")
  sizeBytes        Int               @map("size_bytes")
  status           PlayerVideoStatus @default(PENDING_UPLOAD)
  category         VideoCategory?
  variation        String?
  handedness       Handedness?
  sessionId        String?           @map("session_id") @db.Uuid
  session          PracticeSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  uploadedAt       DateTime?         @map("uploaded_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  comments VideoComment[]
  views    VideoView[]
  report   Report?

  @@index([playerId, createdAt(sort: Desc)], map: "player_videos_player_created_at_idx")
  @@index([playerId, status], map: "player_videos_player_status_idx")
  @@index([sessionId], map: "player_videos_session_id_idx")
  @@map("player_videos")
  @@schema("public")
}

model PracticeSession {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId  String        @map("player_id") @db.Uuid
  player    Player        @relation(fields: [playerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name      String
  category  VideoCategory
  videos    PlayerVideo[]
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([playerId, createdAt(sort: Desc)], map: "practice_sessions_player_created_at_idx")
  @@map("practice_sessions")
  @@schema("public")
}

model Report {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  videoId       String       @unique @map("video_id") @db.Uuid
  video         PlayerVideo  @relation(fields: [videoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  status        ReportStatus @default(PENDING)
  schemaVersion Int?         @map("schema_version")
  payload       Json?
  error         String?
  modelVersion  String?      @map("model_version")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("reports")
  @@schema("public")
}

model StatEntry {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId     String   @map("player_id") @db.Uuid
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  matchDate    DateTime @map("match_date") @db.Date
  opponent     String?
  // batting
  runs         Int?
  ballsFaced   Int?     @map("balls_faced")
  dismissal    String?
  // bowling
  oversBowled  Decimal? @map("overs_bowled") @db.Decimal(4, 1)
  wickets      Int?
  runsConceded Int?     @map("runs_conceded")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([playerId, matchDate(sort: Desc)], map: "stat_entries_player_match_date_idx")
  @@map("stat_entries")
  @@schema("public")
}

model Goal {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId    String    @map("player_id") @db.Uuid
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  title       String
  metric      String?
  target      Decimal?  @db.Decimal(10, 2)
  horizonDate DateTime? @map("horizon_date") @db.Date
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([playerId, createdAt(sort: Desc)], map: "goals_player_created_at_idx")
  @@map("goals")
  @@schema("public")
}

model Reminder {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId    String    @map("player_id") @db.Uuid
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  text        String
  dueAt       DateTime? @map("due_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([playerId, dueAt], map: "reminders_player_due_at_idx")
  @@map("reminders")
  @@schema("public")
}

model VideoComment {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  videoId        String      @map("video_id") @db.Uuid
  video          PlayerVideo @relation(fields: [videoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  authorId       String      @map("author_id") @db.Uuid
  author         AuthUser    @relation("VideoCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  authorUsername String      @map("author_username")
  authorName     String      @map("author_name")
  body           String
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([videoId, createdAt], map: "video_comments_video_created_at_idx")
  @@map("video_comments")
  @@schema("public")
}

model VideoView {
  videoId  String      @map("video_id") @db.Uuid
  video    PlayerVideo @relation(fields: [videoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  viewerId String      @map("viewer_id") @db.Uuid
  viewer   AuthUser    @relation("VideoViewViewer", fields: [viewerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  viewedAt DateTime    @default(now()) @map("viewed_at") @db.Timestamptz(6)

  @@id([videoId, viewerId])
  @@index([viewerId], map: "video_views_viewer_idx")
  @@map("video_views")
  @@schema("public")
}

model AuthUser {
  id                   String         @id @db.Uuid
  player               Player?        @relation("PlayerAuthUser")
  coach                Coach?         @relation("CoachAuthUser")
  guardian             Guardian?      @relation("GuardianAuthUser")
  profile              Profile?       @relation("ProfileAuthUser")
  connectionsAsUserA   Connection[]   @relation("ConnectionUserA")
  connectionsAsUserB   Connection[]   @relation("ConnectionUserB")
  requestedConnections Connection[]   @relation("ConnectionRequester")
  sentMessages         Message[]      @relation("MessageSender")
  videoComments        VideoComment[] @relation("VideoCommentAuthor")
  videoViews           VideoView[]    @relation("VideoViewViewer")

  @@map("users")
  @@schema("auth")
}
