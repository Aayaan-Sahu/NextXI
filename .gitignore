# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
.gstack/

# impeccable design-hook scratch (config.json is shared and committed)
.impeccable/hook.cache.json
.impeccable/config.local.json

# Tutorial captures: large, regenerated by scripts/capture-tutorial.mjs
/remotion/public/captures
/out
scripts/.demo-world.json

# Supabase CLI scratch (link state, version checks)
/supabase/.temp
